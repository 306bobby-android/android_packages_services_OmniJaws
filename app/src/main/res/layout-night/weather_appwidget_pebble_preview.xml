<!-- The pebble root is held square and centred: the provider sets its width
     and height to min(cell width, cell height) so the shape never goes oval on
     a cell that is not square. Every size in here is a placeholder for the
     static preview - the provider rescales all of them to the square it
     picked. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/pebble_root"
        android:layout_width="@dimen/weather_pebble_size"
        android:layout_height="@dimen/weather_pebble_size"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/pebble_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/weather_appwidget_pebble"
            android:tint="@color/weather_pebble_bg_dark" />

        <TextView
            android:id="@+id/pebble_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_alignStart="@+id/pebble_icon"
            android:layout_marginTop="@dimen/weather_pebble_temp_margin_top"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/weather_pebble_text_dark"
            android:textSize="@dimen/weather_pebble_temp_size"
            android:text="21°" />

        <ImageView
            android:id="@+id/pebble_icon"
            android:layout_width="@dimen/weather_pebble_icon_size"
            android:layout_height="@dimen/weather_pebble_icon_size"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="@dimen/weather_pebble_icon_margin"
            android:layout_marginBottom="@dimen/weather_pebble_icon_margin"
            android:scaleType="fitCenter"
            android:src="@drawable/google_new_30" />

        <TextView
            android:id="@+id/info_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:paddingStart="@dimen/weather_pebble_icon_margin"
            android:paddingEnd="@dimen/weather_pebble_icon_margin"
            android:textColor="@color/weather_pebble_text_dark"
            android:textSize="14sp"
            android:visibility="gone" />

    </RelativeLayout>

</FrameLayout>
