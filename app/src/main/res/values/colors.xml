<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="colorPrimary">@android:color/system_accent1_600</color>
    <!-- Pebble widget, themed to match the DeskClock digital widget. Clock
         parents both its light- and dark-background variants on a *Light*
         dynamic theme and colours the clock ?attr/colorPrimaryContainer, which
         resolves to system_accent1_100 either way - hence one text colour for
         both. Named directly rather than as theme attributes so they resolve
         whatever theme the host inflates the widget with. -->
    <color name="weather_pebble_bg_light">@android:color/system_accent2_100</color>
    <color name="weather_pebble_text_light">@android:color/system_accent1_100</color>
    <color name="weather_pebble_bg_dark">@android:color/system_accent2_800</color>
    <color name="weather_pebble_text_dark">@android:color/system_accent1_100</color>
</resources>
